{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clean",
      "type": "shell",
      "command": "mvn",
      "args": ["clean"],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Prettier",
      "type": "shell",
      "command": "mvn",
      "args": ["prettier:write", "-f", "replacer-backend/pom.xml"],
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "mvn",
      "args": [
        "install",
        "-DskipTests",
        "-T",
        "1.0C",
        "-f",
        "replacer-backend/pom.xml"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "install"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install Benchmark",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "install",
        "-P",
        "benchmark",
        "-f",
        "replacer-backend/pom.xml"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Install Frontend",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "install", "-f", "replacer-frontend/pom.xml"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Frontend (Angular)",
      "type": "shell",
      "command": "npm",
      "args": ["start"],
      "options": {
        "cwd": "${workspaceFolder}/replacer-frontend"
      },
      "isBackground": true,
      "group": "none",
      "problemMatcher": ["$tsc-watch"]
    },
    {
      "label": "Run Offline",
      "type": "process",
      "command": "mvn",
      "args": [
        "spring-boot:run",
        "-P",
        "offline",
        "-f",
        "replacer-backend/replacer-app/pom.xml"
      ],
      "group": "none",
      "dependsOn": "Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run Offline Backend",
      "type": "process",
      "command": "mvn",
      "args": [
        "spring-boot:run",
        "-P",
        "offline,backend",
        "-f",
        "replacer-backend/replacer-app/pom.xml"
      ],
      "group": "none",
      "dependsOn": "Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run DB-Local",
      "type": "process",
      "command": "mvn",
      "args": [
        "spring-boot:run",
        "-P",
        "db-local",
        "-f",
        "replacer-backend/replacer-app/pom.xml"
      ],
      "group": "none",
      "dependsOn": "Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run DB-Local Backend",
      "type": "process",
      "command": "mvn",
      "args": [
        "spring-boot:run",
        "-P",
        "db-local,backend",
        "-f",
        "replacer-backend/replacer-app/pom.xml"
      ],
      "group": "none",
      "dependsOn": "Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Run DB-Prod",
      "type": "process",
      "command": "mvn",
      "args": [
        "spring-boot:run",
        "-P",
        "db-prod",
        "-f",
        "replacer-backend/replacer-app/pom.xml"
      ],
      "group": "none",
      "dependsOn": "Build",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "mvn",
      "args": ["clean", "test", "-f", "replacer-backend/pom.xml"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test Finder",
      "type": "shell",
      "command": "mvn",
      "args": [
        "clean",
        "test",
        "-f",
        "replacer-backend/replacer-finder/pom.xml"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
